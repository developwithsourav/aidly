# Copy to .env and fill in. Nothing here has a working default on purpose.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL 16 with PostGIS and pgvector
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# Must be at least 32 characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Photo storage: local disk, or any S3 compatible service you host
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/uploads

# Triage. All optional. With none set, deterministic rules are used and the
# API reports triage_source="rules" rather than pretending otherwise.
SEVERITY_MODEL_PATH=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
